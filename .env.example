# ViralForge Experimental: local configuration.
# Copy this file to ".env" in the repo root and replace every YOUR_... placeholder.
# ".env" is git-ignored. NEVER commit it and never paste these values into chat.

# ───────────── Supabase (https://supabase.com/dashboard → your project → Project Settings → API) ─────────────
# Project URL, e.g. https://abcdxyzcompany.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# PUBLIC key for the browser app (labelled "anon" or "publishable"). Safe to expose; used for sign-in only.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# SECRET key for the backend only (labelled "service_role" or "secret"). It bypasses all security rules.
# It is never copied into the frontend config. Keep it private.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# Private storage bucket created by supabase/setup.sql. Leave as "videos".
STORAGE_BUCKET=videos

# ───────────── Gemini (https://aistudio.google.com/apikey) ─────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model to use. The backend verifies at startup that your key can use it and reports a clear error if not.
# It never silently switches to another model. Change this value if the check fails.
GEMINI_MODEL=gemini-3.8-flash

# ───────────── Upload limits ─────────────
# Supabase's free plan rejects single files above 50 MB, so keep MAX_UPLOAD_MB at 50 or lower there.
MAX_UPLOAD_MB=50
MIN_VIDEO_SECONDS=1
MAX_VIDEO_SECONDS=90
ALLOWED_EXTENSIONS=mp4,webm,mov

# ───────────── Local servers ─────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Origins allowed to call the API from a browser (comma-separated). Must include the frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL the browser app uses to reach the API.
API_BASE_URL=http://localhost:8000/api/v1

# ───────────── Optional tuning (defaults are fine) ─────────────
# APP_ENV=development
# LOG_LEVEL=INFO
# WORKER_ENABLED=true
# JOB_LEASE_SECONDS=900
# MAX_JOB_ATTEMPTS=3
# GEMINI_TIMEOUT_SECONDS=180
# SIGNED_URL_TTL_SECONDS=300
# RATE_LIMIT_PER_MINUTE=120
# UPLOAD_LIMIT_PER_HOUR=20
# ANALYSIS_LIMIT_PER_HOUR=20
